# Copy this file to .env.local and fill in your own credentials.
# Never commit .env.local or real private keys.

# App/admin
ADMIN_PASSWORD=
CRON_SECRET=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional AI analysis routes
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-7

# Kalshi
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----"
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# Polymarket international CLOB
POLYMARKET_REGION=intl
POLYMARKET_WALLET_KEY=
POLYMARKET_SIG_TYPE=
POLYMARKET_FUNDER=
POLYMARKET_DEPOSIT_WALLET=
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
POLYGON_USDC_ADDRESS=

# Polymarket US API credentials, only when POLYMARKET_REGION=us
POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET=

# SX.bet
SXBET_WALLET_KEY=
SX_RPC_URL=https://rpc-rollup.sx.technology
SXBET_ODDS_SLIPPAGE=0

# predict.fun
PREDICTFUN_API_KEY=
PREDICTFUN_WALLET_KEY=
PREDICTFUN_ACCOUNT=
BNB_RPC_URL=https://bsc-dataseed.binance.org

# CloudBet
CLOUDBET_API_KEY=
CLOUDBET_CURRENCY=USDT

# Props/value-play provider
SPORTSGAMEODDS_KEY=

# Reconciliation tuning
ARB_RECON_ATTEMPTS=3
ARB_RECON_DELAY_MS=1500
